{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "front",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "front-next", "run", "dev"],
      "port": 3000
    },
    {
      "name": "front-mock",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set NEXT_PUBLIC_USE_MOCKS=true&& npm --prefix front-next run dev -- -p 3001"],
      "port": 3001
    }
  ]
}
